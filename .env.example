# ==============================================================================
# WELFOG VOICE AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Configuration (Google GenAI Multimodal Live API)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
GEMINI_VOICE_NAME=Aoede

# ------------------------------------------------------------------------------
# 2. TeleCMI / PIOPIY Telephony Configuration
# ------------------------------------------------------------------------------
# Credentials from TeleCMI Dashboard / API.md
TELECMI_APP_ID=33338876
TELECMI_APP_SECRET=your_telecmi_app_secret_here
TELECMI_SBC=sbcind.telecmi.com
TELECMI_USER_ID=5002_33338876
TELECMI_USER_PASSWORD=your_telecmi_user_password_here
TELECMI_REST_BASE=https://rest.telecmi.com
TELECMI_CALLER_ID=33338876

# ------------------------------------------------------------------------------
# 3. Welfog Existing Order APIs
# ------------------------------------------------------------------------------
WELFOG_API_BASE=https://welfogapi.welfog.com
SUPPLIER_SERVICE_BASE=https://supplierservice.welfog.com

# ------------------------------------------------------------------------------
# 4. Welfog Knowledge Base (Existing aidata.welfog.com API or direct Qdrant)
# ------------------------------------------------------------------------------
# Existing Admin Portal: https://aidata.welfog.com/admin
# Preferred: Existing Search API (header x-api-key)
WELFOG_KNOWLEDGE_API_URL=https://aidata.welfog.com/api/search
WELFOG_KNOWLEDGE_API_KEY=your_welfog_knowledge_api_key_here

# Optional: Direct Qdrant cluster connection (if accessing Qdrant directly)
QDRANT_URL=https://your-qdrant-cluster.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=company_knowledge

# ------------------------------------------------------------------------------
# 5. Voice Server Public Endpoints (for TeleCMI Webhooks & WebSockets)
# ------------------------------------------------------------------------------
# Public HTTPS URL exposed via ngrok or domain
VOICE_SERVER_PUBLIC_URL=https://your-domain.ngrok-free.app
# WebSocket URL for bidirectional audio streaming
TELECMI_WEBSOCKET_URL=wss://your-domain.ngrok-free.app/ws/telecmi

# ------------------------------------------------------------------------------
# 6. Server Runtime Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
